{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "images": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "published_ref": {
            "type": "string"
          },
          "requested_ref": {
            "type": "string"
          }
        },
        "required": [
          "requested_ref",
          "published_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "awx-docker.published-images/v1"
    },
    "upstream": {
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        },
        "resolved_revision": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "requested_ref",
        "resolved_revision"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "images",
    "upstream"
  ],
  "type": "object"
}
