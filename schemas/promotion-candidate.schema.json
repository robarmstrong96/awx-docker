{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "image": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "tag",
        "ref"
      ],
      "type": "object"
    },
    "lock_file": {
      "const": "awx.lock.yml"
    },
    "promotion": {
      "type": "object"
    },
    "schema_version": {
      "const": "awx-docker.promotion-candidate/v1"
    },
    "status": {
      "const": "passed"
    },
    "upstream": {
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        },
        "resolved_revision": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "requested_ref",
        "resolved_revision"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "lock_file",
    "upstream",
    "image",
    "promotion"
  ],
  "type": "object"
}
