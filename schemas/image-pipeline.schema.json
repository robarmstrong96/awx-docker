{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "evidence": {
      "additionalProperties": true,
      "properties": {
        "build_metadata": {
          "type": "string"
        },
        "image_verification": {
          "type": "string"
        },
        "upstream_health": {
          "type": "string"
        },
        "upstream_ref": {
          "type": "string"
        }
      },
      "required": [
        "upstream_ref",
        "upstream_health",
        "build_metadata",
        "image_verification"
      ],
      "type": "object"
    },
    "image": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "tag",
        "ref"
      ],
      "type": "object"
    },
    "platform": {
      "type": "string"
    },
    "schema_version": {
      "const": "awx-docker.image-pipeline/v1"
    },
    "status": {
      "const": "passed"
    },
    "upstream": {
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        },
        "resolved_revision": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "requested_ref",
        "resolved_revision"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "upstream",
    "image",
    "platform",
    "evidence"
  ],
  "type": "object"
}
