{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "image": {
      "additionalProperties": true,
      "properties": {
        "published_ref": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        }
      },
      "required": [
        "requested_ref",
        "published_ref"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "awx-docker.published-image/v1"
    },
    "upstream": {
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        },
        "resolved_revision": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "requested_ref",
        "resolved_revision"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "image",
    "upstream"
  ],
  "type": "object"
}
