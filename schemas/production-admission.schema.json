{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "checks": {
      "additionalProperties": true,
      "properties": {
        "branch_policy": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "branch_policy_reason": {
          "type": "string"
        },
        "lock_file": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "lock_file_present": {
          "type": "boolean"
        },
        "lock_file_reason": {
          "type": "string"
        },
        "public_readiness": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "publication_gate": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "publication_gate_reason": {
          "type": "string"
        }
      },
      "required": [
        "lock_file_present",
        "lock_file",
        "lock_file_reason",
        "branch_policy",
        "branch_policy_reason",
        "public_readiness",
        "publication_gate",
        "publication_gate_reason"
      ],
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "schema_version": {
      "const": "awx-docker.production-admission/v1"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "reason",
    "checks"
  ],
  "type": "object"
}
