{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "fail",
              "warn"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "severity",
          "path",
          "line",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "missing_required_files": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "awx-docker.public-readiness/v1"
    },
    "status": {
      "enum": [
        "fail",
        "pass"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "findings",
    "missing_required_files"
  ],
  "type": "object"
}
