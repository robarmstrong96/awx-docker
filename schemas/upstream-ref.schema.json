{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "repository": {
      "type": "string"
    },
    "requested_ref": {
      "type": "string"
    },
    "resolved_revision": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "schema_version": {
      "const": "awx-docker.upstream-ref/v1"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "requested_ref",
    "resolved_revision"
  ],
  "type": "object"
}
