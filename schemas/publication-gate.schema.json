{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "checks": {
      "additionalProperties": true,
      "properties": {
        "public_readiness": {
          "type": "string"
        },
        "public_readiness_reason": {
          "type": "string"
        },
        "upstream_health": {
          "type": "string"
        },
        "upstream_health_reason": {
          "type": "string"
        },
        "image_verification": {
          "enum": [
            "pass",
            "fail",
            "not_required"
          ]
        },
        "image_verification_reason": {
          "type": "string"
        }
      },
      "required": [
        "public_readiness",
        "public_readiness_reason",
        "upstream_health",
        "upstream_health_reason",
        "image_verification",
        "image_verification_reason"
      ],
      "type": "object"
    },
    "policy": {
      "additionalProperties": true,
      "properties": {
        "required_checks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "required_checks"
      ],
      "type": "object"
    },
    "purpose": {
      "enum": [
        "repository",
        "image-publication",
        "production-admission",
        "production-promotion"
      ]
    },
    "reason": {
      "type": "string"
    },
    "schema_version": {
      "const": "awx-docker.publication-gate/v1"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "reason",
    "purpose",
    "policy",
    "checks"
  ],
  "type": "object"
}
