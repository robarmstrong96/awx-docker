{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "checks": {
      "additionalProperties": true,
      "properties": {
        "public_readiness": {
          "type": "string"
        },
        "public_readiness_reason": {
          "type": "string"
        },
        "upstream_health": {
          "type": "string"
        },
        "upstream_health_reason": {
          "type": "string"
        }
      },
      "required": [
        "public_readiness",
        "public_readiness_reason",
        "upstream_health",
        "upstream_health_reason"
      ],
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "schema_version": {
      "const": "awx-docker.publication-gate/v1"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "reason",
    "checks"
  ],
  "type": "object"
}
