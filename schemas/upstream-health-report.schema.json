{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "decision": {
      "additionalProperties": true,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "state": {
          "enum": [
            "pass",
            "warn",
            "wait",
            "fail",
            "unknown",
            "waived"
          ]
        }
      },
      "required": [
        "state",
        "blocking",
        "reason"
      ],
      "type": "object"
    },
    "provider": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "signal_source": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "signal_source"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "awx-docker.upstream-health/v2"
    },
    "signals": {
      "additionalProperties": true,
      "properties": {
        "ci": {
          "additionalProperties": true,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "blocking_failures": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "non_blocking_failures": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "pending": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "provider": {
              "type": "string"
            },
            "required_success_missing": {
              "type": "boolean"
            },
            "required_success_observed": {
              "type": "boolean"
            },
            "total": {
              "minimum": 0,
              "type": "integer"
            },
            "unknown_failures": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "warnings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "provider",
            "available",
            "total",
            "blocking_failures",
            "non_blocking_failures",
            "unknown_failures",
            "pending",
            "warnings",
            "required_success_observed",
            "required_success_missing"
          ],
          "type": "object"
        }
      },
      "required": [
        "ci"
      ],
      "type": "object"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "repository": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        },
        "resolved_revision": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "requested_ref",
        "resolved_revision"
      ],
      "type": "object"
    },
    "waiver": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "subject",
    "provider",
    "signals",
    "decision",
    "waiver"
  ],
  "type": "object"
}
