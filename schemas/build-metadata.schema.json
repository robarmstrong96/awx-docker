{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "awx": {
      "additionalProperties": true,
      "properties": {
        "repo": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string"
        },
        "resolved_ref": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "requested_ref",
        "resolved_ref"
      ],
      "type": "object"
    },
    "image": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "tag",
        "ref"
      ],
      "type": "object"
    },
    "platform": {
      "type": "string"
    },
    "schema_version": {
      "const": "awx-docker.build-metadata/v1"
    },
    "wrapper_revision": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "image",
    "awx",
    "wrapper_revision",
    "platform"
  ],
  "type": "object"
}
