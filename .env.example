# AWX is cloned during Docker build, not on the host.
AWX_REPO=https://github.com/ansible/awx.git
AWX_REF=devel

RECEPTOR_IMAGE=quay.io/ansible/receptor:devel

# Private image target. Use a private registry/package until licensing gates
# are complete.
IMAGE_NAME=ghcr.io/YOUR_ORG/awx-devel
IMAGE_TAG=devel
PLATFORM=linux/amd64

# Set PUSH=true only in trusted private CI or an explicit local publish.
PUSH=false
