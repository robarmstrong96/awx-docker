# Upstream AWX checkout. This repo tracks orchestration only; AWX itself is
# cloned outside this repo so there is no nested .git project under awx-docker.
AWX_UPSTREAM_URL=https://github.com/ansible/awx.git
AWX_BRANCH=devel
AWX_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/awx-docker/awx

# AWX's docker-compose target defaults image tags to the active git branch.
# Keep this pinned to devel when using the published development image.
COMPOSE_TAG=devel
RECEPTOR_IMAGE=quay.io/ansible/receptor:devel

# Normal startup is detached. Set this blank to attach to logs.
COMPOSE_UP_OPTS=-d

# Optional first-run admin password. If unset, AWX generates one under
# $AWX_DIR/tools/docker-compose/_sources/secrets/admin_password.yml.
# ADMIN_PASSWORD=change-me

# Local topology knobs supported by AWX's compose templates.
CONTROL_PLANE_NODE_COUNT=1
EXECUTION_NODE_COUNT=0

# Optional services supported by AWX's compose templates.
PGBOUNCER=false
PROMETHEUS=false
GRAFANA=false
VAULT=false
VAULT_TLS=false
OTEL=false
LOKI=false
SPLUNK=false
EDITABLE_DEPENDENCIES=false
PG_TLS=false
