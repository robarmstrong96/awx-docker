#!/usr/bin/env bash
#
# Verify the built image contains the AWX source, runtime helpers, Python
# metadata, and source-license files expected by this wrapper.
#
# Comment style:
# https://google.github.io/styleguide/shellguide.html#comments
#
# Why set -euo pipefail:
# https://gist.github.com/mohanpedala/1e2ff5661761d3abd0385e8223e16425?permalink_comment_id=3799230
set -euo pipefail

image_ref="${1:-awx-devel:devel}"

test -f /awx_devel/manage.py
test -f /awx_devel/LICENSE.md
test ! -e /awx_devel/.git
test -f /awx_devel/awx/ui/.awx_ui_repo
test -f /awx_devel/awx/ui/.awx_ui_requested_ref
test -f /awx_devel/awx/ui/.awx_ui_source_revision
test ! -e /awx_devel/awx/ui/src/.git
test -x /usr/local/bin/awx-wrapper-entrypoint
test -x /usr/local/bin/awx-wrapper-healthcheck
test -f /etc/supervisord.conf
test -x /usr/local/bin/awx-manage

/var/lib/awx/venv/awx/bin/python /usr/local/libexec/awx-docker/verify-awx-python-contract

test -f /usr/share/licenses/awx-wrapper/AWX-LICENSE.md
test -f /usr/share/licenses/awx-wrapper/AWX-REQUESTED-REF
test -f /usr/share/licenses/awx-wrapper/AWX-SOURCE-REVISION

printf 'runtime-contract: ok (%s)\n' "$image_ref"
