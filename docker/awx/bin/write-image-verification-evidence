#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--evidence-dir", required=True, type=Path)
    parser.add_argument("--image-ref", required=True)
    parser.add_argument("--requested-ref", required=True)
    parser.add_argument("--source-revision", required=True)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    args.evidence_dir.mkdir(parents=True, exist_ok=True)

    data = {
        "awx": {
            "git_metadata": "absent",
            "requested_ref": args.requested_ref,
            "source_revision": args.source_revision,
        },
        "image": {
            "ref": args.image_ref,
        },
        "schema_version": "awx-docker.image-verification/v1",
        "status": "passed",
    }

    (args.evidence_dir / "image-verification.json").write_text(
        json.dumps(data, indent=2) + "\n"
    )
    (args.evidence_dir / "image-verification.md").write_text(
        "\n".join(
            [
                "# AWX Image Verification",
                "",
                f"- Image: `{args.image_ref}`",
                f"- AWX requested ref: `{args.requested_ref}`",
                f"- AWX source revision: `{args.source_revision}`",
                "- Embedded AWX git metadata: absent",
                "- Status: passed",
            ]
        )
        + "\n"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
